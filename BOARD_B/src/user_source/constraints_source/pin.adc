set_pin_assignment { eth_txd[3] }    { LOCATION = T8;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# Ethernet status/debug outputs on J2 pins 31..40.
set_pin_assignment { eth_link_speed[0] } { LOCATION = M12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
set_pin_assignment { eth_link_speed[1] } { LOCATION = M11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
