set_pin_assignment { link_miso_extra[10] } { LOCATION = N16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }

# NET26: original standalone network MOSI8..11 pin positions.
set_pin_assignment { link_mosi_extra[7] } { LOCATION = D16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_mosi_extra[8] } { LOCATION = F14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_mosi_extra[9] } { LOCATION = F15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_mosi_extra[10] } { LOCATION = G14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }

# Board LEDs are separate from all twenty-six inter-board signal wires.
set_pin_assignment { startup_clk50_alive } { LOCATION = A4; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { startup_video_alive } { LOCATION = A3; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { startup_ready } { LOCATION = C10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { startup_lcd_done } { LOCATION = B12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
