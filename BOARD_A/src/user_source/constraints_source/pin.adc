set_pin_assignment { tp_int_n } { IOSTANDARD = LVCMOS33; }
set_pin_assignment { tp_int_n } { PULLTYPE = NONE; }
# GPIOB25 / J2-28
set_pin_assignment { tp_rst_n } { LOCATION = J11; }
set_pin_assignment { tp_rst_n } { IOSTANDARD = LVCMOS33; }
set_pin_assignment { tp_rst_n } { PULLTYPE = NONE; }

set_pin_assignment { link_cs_n } { LOCATION = K15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
set_pin_assignment { link_sck } { LOCATION = M15; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
set_pin_assignment { link_mosi } { LOCATION = K16; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
set_pin_assignment { link_miso } { LOCATION = J16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }

# NET_VIDEO_LINK_8_12: audited extension lanes; original lane0 is retained.
set_pin_assignment { link_mosi_extra[0] } { LOCATION = D14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_mosi_extra[1] } { LOCATION = G11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_mosi_extra[2] } { LOCATION = G12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_mosi_extra[3] } { LOCATION = J14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_mosi_extra[4] } { LOCATION = J13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_mosi_extra[5] } { LOCATION = K12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_mosi_extra[6] } { LOCATION = L14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_miso_extra[0] } { LOCATION = F13; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_miso_extra[1] } { LOCATION = H13; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_miso_extra[2] } { LOCATION = H14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_miso_extra[3] } { LOCATION = M14; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_miso_extra[4] } { LOCATION = P11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_miso_extra[5] } { LOCATION = G16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_miso_extra[6] } { LOCATION = E15; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_miso_extra[7] } { LOCATION = H15; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
set_pin_assignment { link_miso_extra[8] } { LOCATION = H16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLDOWN; }
