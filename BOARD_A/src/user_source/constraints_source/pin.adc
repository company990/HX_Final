# ===================== HUB75 频谱屏 (Phase3/4, 用户最终确认) =====================
# 单端 LVCMOS33; 与工程其它普通 IO 一致。封装 Ball 见注释; 不与已占用引脚冲突。






set_pin_assignment { uart_rx } { LOCATION = F12; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { uart_tx } { LOCATION = D12; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# SW4 selects key ownership: high=audio, low=image. SW3 selects SD/Ethernet below.
# Physical KEY2=B2 (key1) next song; KEY4=C1 (key2) previous song.
set_pin_assignment { audio_mode_sw } { LOCATION = C5; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# Physical KEY3: audio start/pause in SW4 high mode.
set_pin_assignment { audio_key3_n } { LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# SW2 selects only FFT source. ADC CH1 owns M10 / J1-16.
set_pin_assignment { spectrum_mic_sw } { LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# HC-SR501 PIR 人体在场传感器 OUT(音频软复位源)。用户指定 M16, 已确认未被其它约束占用。
# PULLUP: 传感器未接/拔出时默认读"在场"=系统照常运行, 避免误判缺勤长期静音。
set_pin_assignment { pir_out } { LOCATION = M16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# RTL8211E RGMII/MDIO interface.
set_pin_assignment { eth_mdc }       { LOCATION = L13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
set_pin_assignment { eth_mdio }      { LOCATION = M13; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
set_pin_assignment { eth_rxc }       { LOCATION = T14; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_rx_ctl }    { LOCATION = T13; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_rxd[0] }    { LOCATION = P6;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_rxd[1] }    { LOCATION = M6;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_rxd[2] }    { LOCATION = T9;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_rxd[3] }    { LOCATION = N9;  IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
set_pin_assignment { eth_txc }       { LOCATION = T12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { eth_tx_ctl }    { LOCATION = T7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { eth_txd[0] }    { LOCATION = T4;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { eth_txd[1] }    { LOCATION = T6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { eth_txd[2] }    { LOCATION = M7;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }
set_pin_assignment { eth_txd[3] }    { LOCATION = T8;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = NONE; }

# Ethernet status/debug outputs on J2 pins 31..40.
set_pin_assignment { eth_link_speed[0] } { LOCATION = M12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
set_pin_assignment { eth_link_speed[1] } { LOCATION = M11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
set_pin_assignment { eth_rx_overflow }   { LOCATION = N12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
set_pin_assignment { eth_tx_overflow }   { LOCATION = P14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
set_pin_assignment { eth_ip_error }      { LOCATION = P12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }
set_pin_assignment { eth_arp_error }     { LOCATION = R12; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = NONE; }

# SW3 selects the WAV source: low=TF/SD, high=Ethernet.
set_pin_assignment { sw3 } { LOCATION = C6; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# User-approved SW1; KEY3 B1 stays shared through SW4.
set_pin_assignment { adjust_select } { LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

